GEMINI_API_KEY=your-gemini-api-key-here
CURSOR_API_KEY=your-cursor-api-key-here
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/content_pipeline
REDIS_URL=redis://localhost:6379
CRITIC_SCORE_THRESHOLD=7.0
GEMINI_MODEL=gemini-2.0-flash
GEMINI_CRITIC_MODEL=gemini-2.0-flash
CURSOR_MODEL=composer-2.5
CURSOR_CRITIC_MODEL=composer-2.5
LLM_PROVIDER=auto
USE_FAKE_LLM=false
